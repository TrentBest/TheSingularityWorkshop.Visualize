{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesingularityworkshop.dev/schemas/research-demonstrations.schema.json",
  "title": "Workshop Research Demonstration Catalog",
  "description": "Versioned gameplay-laboratory orders. Prices, setup times, temperatures, and combat-frequency assumptions are fictional simulation data unless explicitly replaced by traced measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "currency",
    "demonstrations",
    "simulationAssumptions",
    "simulationDisclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "const": "fictional-demo-proposals-not-measured-engineering-data"
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "demonstrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/demonstration"
      }
    },
    "simulationAssumptions": {
      "$ref": "#/$defs/simulationAssumptions"
    },
    "simulationDisclaimer": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "demonstration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "partId",
        "cost",
        "setupMinutes",
        "description",
        "sequence",
        "effects",
        "researchQuestion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "partId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "cost": {
          "type": "integer",
          "minimum": 1
        },
        "setupMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "impact",
            "penetration",
            "barrelHeat",
            "armorHeat",
            "heatDistortion",
            "scientistDialogue"
          ],
          "properties": {
            "impact": {
              "type": "boolean"
            },
            "penetration": {
              "type": "boolean"
            },
            "barrelHeat": {
              "type": "boolean"
            },
            "armorHeat": {
              "type": "boolean"
            },
            "heatDistortion": {
              "type": "boolean"
            },
            "scientistDialogue": {
              "type": "boolean"
            }
          }
        },
        "researchQuestion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "simulationAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mostFrequentlyHitArmorPartId",
        "hitFrequencyBasis",
        "hitFrequencyStatus",
        "hitShare",
        "note"
      ],
      "properties": {
        "mostFrequentlyHitArmorPartId": {
          "type": "string"
        },
        "hitFrequencyBasis": {
          "const": "fictional-combat-telemetry"
        },
        "hitFrequencyStatus": {
          "const": "gameplay-premise-not-measured"
        },
        "hitShare": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
