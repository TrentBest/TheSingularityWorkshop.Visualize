{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesingularityworkshop.com/schemas/soldier-part.schema.json",
  "title": "Workshop Soldier Part Record",
  "description": "A reusable engineering record from which cut sheets, research-board entries, and visual representations can be derived. Unknown engineering values must remain explicitly unresolved rather than invented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "partId",
    "displayName",
    "revision",
    "maturity",
    "geometry",
    "material",
    "interfaces",
    "manufacturing",
    "inspection",
    "research",
    "traceability"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "partId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "enum": [
        "concept",
        "silhouette-blockout",
        "engineering-study",
        "prototype",
        "qualified",
        "production",
        "retired"
      ]
    },
    "category": {
      "type": "string"
    },
    "parentPartId": {
      "type": [
        "string",
        "null"
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAssetId",
        "primitive",
        "units",
        "nominal"
      ],
      "properties": {
        "sourceAssetId": {
          "type": "string"
        },
        "primitive": {
          "enum": [
            "box",
            "ellipsoid",
            "mesh",
            "assembly",
            "none"
          ]
        },
        "units": {
          "const": "metres"
        },
        "nominal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "dimensions"
          ],
          "properties": {
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "dimensions": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "dimensionsMeaning": {
              "enum": [
                "size",
                "radii"
              ]
            },
            "coordinateSystem": {
              "const": "soldier-local:+Y-up,+Z-forward,+X-right"
            }
          }
        },
        "tolerance": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "specified",
                "to-be-engineered",
                "not-applicable"
              ]
            },
            "linear": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "angularDegrees": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "datumReference": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialKey",
        "specificationStatus",
        "specification"
      ],
      "properties": {
        "materialKey": {
          "type": "string"
        },
        "specificationStatus": {
          "enum": [
            "fictional-concept",
            "to-be-engineered",
            "specified"
          ]
        },
        "specification": {
          "type": "string"
        },
        "massKg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "densityKgM3": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "thermal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operatingRangeC": {
              "type": [
                "array",
                "null"
              ],
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "conductivityWmK": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "electromagnetic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permeabilityStatus": {
              "type": "string"
            },
            "shieldingStatus": {
              "type": "string"
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interfaceId",
          "type",
          "maturity"
        ],
        "properties": {
          "interfaceId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "mechanical",
              "electrical",
              "thermal",
              "fluid",
              "data",
              "neural",
              "optical",
              "service",
              "mounting"
            ]
          },
          "matingPartId": {
            "type": [
              "string",
              "null"
            ]
          },
          "maturity": {
            "enum": [
              "defined",
              "provisional",
              "to-be-engineered"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "manufacturing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "process",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "concept",
            "to-be-engineered",
            "defined",
            "qualified"
          ]
        },
        "process": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "stockForm": {
          "type": [
            "string",
            "null"
          ]
        },
        "finish": {
          "type": [
            "string",
            "null"
          ]
        },
        "assemblySequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-defined",
            "draft",
            "qualified"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkId",
              "method",
              "acceptanceStatus"
            ],
            "properties": {
              "checkId": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "acceptanceStatus": {
                "enum": [
                  "to-be-defined",
                  "pass-fail-defined",
                  "informational"
                ]
              },
              "acceptanceCriteria": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "questions",
        "candidateValues"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-started",
            "active",
            "concluded"
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidateValues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameterId",
              "value",
              "unit",
              "status"
            ],
            "properties": {
              "parameterId": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "hypothesis",
                  "candidate",
                  "measured",
                  "rejected",
                  "accepted",
                  "unknown"
                ]
              },
              "trialId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdFor",
        "lastReviewed",
        "openIssues"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "createdFor": {
          "type": "string"
        },
        "lastReviewed": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "openIssues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cutSheet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includeUnknowns": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
