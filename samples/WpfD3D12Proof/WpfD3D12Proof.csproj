<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>TheSingularityWorkshop.Visualize.WpfD3D12Proof</AssemblyName>
    <RootNamespace>TheSingularityWorkshop.Visualize.WpfD3D12Proof</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
  </ItemGroup>
</Project>
