<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TheSingularityWorkshop.Visualize</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>TheSingularityWorkshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>GPU-facing presentation contracts for the Workshop Renderer, procedural Gesture output, and host-independent visualization.</Description>
    <PackageTags>visualizer;gpu;graphics;compute;renderer;gesture;microbundle;performance</PackageTags>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.Visualize</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.Visualize</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="samples/**/*.cs" />
    <Compile Remove="integrations/**/*.cs" />
    <!-- A referencing WPF host can propagate UseWPF globally. Keep standalone WPF proof/sample XAML out of the Visualize library build; each sample is built by its own project. -->
    <Page Remove="samples/**/*.xaml" />
    <ApplicationDefinition Remove="samples/**/*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <None Update="docs/assets/moniker.svg" Pack="true" PackagePath="docs/assets/" />
  </ItemGroup>
</Project>
