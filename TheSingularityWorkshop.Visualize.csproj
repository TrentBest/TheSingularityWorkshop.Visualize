<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="samples/**/*.cs" />
    <Compile Remove="integrations/**/*.cs" />
    <Compile Remove="ExperiencesSource/**/*.cs" />
    <Compile Remove="src/GPU/**/*.cs" />
    <!-- Keep standalone WPF sample XAML in its own project even when UseWPF flows from a referencing host. -->
    <Page Remove="samples/**/*.xaml" />
    <ApplicationDefinition Remove="samples/**/*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <None Update="docs/assets/moniker.svg" Pack="true" PackagePath="docs/assets/" />
  </ItemGroup>
</Project>
