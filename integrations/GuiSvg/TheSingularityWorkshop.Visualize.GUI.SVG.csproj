  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="GuiSource/**/*.cs" />
    <Compile Remove="Proof/**/*.cs" />
    <Compile Remove="CityMassingProof/**/*.cs" />
    <ProjectReference Include="../../TheSingularityWorkshop.Visualize.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WorkshopGuiSvgProjectPath)' != ''">
    <ProjectReference Include="$(WorkshopGuiSvgProjectPath)" />
  </ItemGroup>
  <ItemGroup Condition="'$(WorkshopGuiSvgProjectPath)' == ''">
