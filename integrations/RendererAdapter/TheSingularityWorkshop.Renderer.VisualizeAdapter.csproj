<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <WorkshopSourceRoot Condition="'$(WorkshopSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../</WorkshopSourceRoot>
    <WorkshopRendererProjectPath Condition="Exists('$(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj')">$(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj</WorkshopRendererProjectPath>
    <WorkshopRendererProjectPath Condition="'$(WorkshopRendererProjectPath)' == '' and Exists('$(MSBuildThisFileDirectory)RendererSource/TheSingularityWorkshop.Renderer.csproj')">$(MSBuildThisFileDirectory)RendererSource/TheSingularityWorkshop.Renderer.csproj</WorkshopRendererProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Renderer is referenced as source here only to compile and test the narrow adapter contract.
         This ProjectReference is not runtime MicroBundle discovery, loading, or composition. -->
    <Compile Remove="RendererSource/**/*.cs" />
    <!-- Experiences is checked out beside the adapter for integration builds; compile it only through its own project. -->
    <Compile Remove="ExperiencesSource/**/*.cs" />
    <Compile Remove="**/ExperiencesSource/**/*.cs" />
    <Compile Remove="**/GuiSource/**/*.cs" />
    <Compile Remove="CapsuleClinicIntegration/**/*.cs" />
    <Compile Remove="CapsuleClinicProof/Program.cs" />
    <Compile Remove="CapsuleClinicProof/**/*.cs" />
    <Compile Remove="**/CapsuleClinicProof/**/*.cs" />
    <Compile Remove="Proof/**/*.cs" />
    <Compile Remove="DroneConstructionProof/**/*.cs" />
    <ProjectReference Include="../../TheSingularityWorkshop.Visualize.csproj" />
    <ProjectReference Include="$(WorkshopRendererProjectPath)" />
  </ItemGroup>

  <Target Name="ValidateWorkshopRendererSource" BeforeTargets="ResolveReferences"
          Condition="'$(WorkshopRendererProjectPath)' == ''">
    <Error Text="Renderer adapter contract tests require the Renderer source checkout at '$(WorkshopSourceRoot)/TheSingularityWorkshop.Renderer/TheSingularityWorkshop.Renderer.csproj' or '$(MSBuildThisFileDirectory)RendererSource/TheSingularityWorkshop.Renderer.csproj'. NuGet package fallback is intentionally unsupported; runtime capability delivery is through the Renderer MicroBundle resolved by FSM_COS." />
  </Target>
</Project>